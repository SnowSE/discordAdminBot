@using Web.Models.Snow
@using Web.Services
@inject SnowCourseService Snow

<div class="mb-4">
  <p class="text-muted small mb-2">
    Open <a href="https://my.snow.edu" target="_blank">my.snow.edu</a>, open DevTools console, paste and run:
  </p>
  <div class="position-relative mb-2">
    <pre class="bg-dark text-light p-3 rounded small pe-5 mb-0" style="white-space: pre-wrap; word-break: break-all;">@SnippetText</pre>
    <button type="button" class="btn btn-sm btn-outline-secondary position-absolute top-0 end-0 m-2"
            @onclick="CopySnippetAsync">
      @(_copied ? "Copied!" : "Copy")
    </button>
  </div>

  <EditForm Model="_model" OnValidSubmit="RefreshAsync">
    <DataAnnotationsValidator />
    <div class="d-flex flex-wrap gap-2 align-items-end">
      <div>
        <label class="form-label small mb-1">Term</label>
        <InputSelect class="form-select form-select-sm" @bind-Value="_model.TermCode">
          @foreach (var termOption in _termOptions)
          {
            <option value="@termOption.TermCode">@termOption.DisplayName</option>
          }
        </InputSelect>
      </div>
      <div class="flex-grow-1">
        <label class="form-label small mb-1">Token</label>
        <InputText class="form-control form-control-sm font-monospace"
                   @bind-Value="_model.JwtToken"
                   autocomplete="off" spellcheck="false" />
      </div>
      <button type="submit" class="btn btn-primary btn-sm" disabled="@_refreshing">
        @if (_refreshing)
        {
          <span class="spinner-border spinner-border-sm me-1"></span>
        }
        Refresh Courses
      </button>
    </div>
    @if (_errorMessage is not null)
    {
      <div class="text-danger small mt-2">@_errorMessage</div>
    }
  </EditForm>
</div>

@code {
  [CascadingParameter]
  protected LoadingBoundaryContext? Loading { get; set; }

  private const string SnippetText =
    "copy(\n" +
    "  JSON.parse(\n" +
    "    localStorage.getItem(\"oidc.user:https://kc.snow.edu/realms/snowcollege/:portal\")\n" +
    "  ).access_token\n" +
    ");\n" +
    "console.log(\"Auth token copied to clipboard\");";

  private readonly RefreshModel _model = new();
  private bool _refreshing;
  private bool _copied;
  private string? _errorMessage;

  private List<(SnowTermCode TermCode, string DisplayName)> _termOptions = [];

  protected override void OnInitialized()
  {
    _termOptions = SnowCourseService.GenerateUpcomingTermOptions();
    _model.TermCode = _termOptions[0].TermCode.Value;
  }

  private async Task CopySnippetAsync()
  {
    _copied = true;
    await Task.Delay(2000);
    _copied = false;
    StateHasChanged();
  }

  private async Task RefreshAsync()
  {
    if (string.IsNullOrWhiteSpace(_model.JwtToken))
    {
      _errorMessage = "Paste your auth token first.";
      return;
    }
    _errorMessage = null;
    _refreshing = true;
    try
    {
      using (Loading?.Start())
      {
        await Snow.RefreshCoursesAsync(_model.TermCode, _model.JwtToken.Trim());
      }
    }
    catch (Exception ex)
    {
      _errorMessage = $"Refresh failed: {ex.Message}";
    }
    finally
    {
      _refreshing = false;
    }
  }

  private sealed class RefreshModel
  {
    public string TermCode { get; set; } = "";
    public string JwtToken { get; set; } = "";
  }
}
