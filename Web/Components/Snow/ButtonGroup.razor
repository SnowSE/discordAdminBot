@typeparam TOption

<div class="d-flex flex-wrap gap-1">
  @foreach (var option in Options)
  {
    var id = IdSelector(option);
    var label = LabelSelector(option);
    var isSelected = id == Value;

    <button class="btn btn-sm text-nowrap flex-shrink-1 @(isSelected ? "btn-secondary" : "btn-outline-secondary")"
            disabled="@(DisableOnSelected && isSelected)" @onclick="() => Select(id)">
      @label
    </button>
  }
</div>

@code {
  [Parameter, EditorRequired] public IReadOnlyList<TOption> Options { get; set; } = default!;
  [Parameter] public string? Value { get; set; }
  [Parameter, EditorRequired] public Func<TOption, string> IdSelector { get; set; } = default!;
  [Parameter, EditorRequired] public Func<TOption, string> LabelSelector { get; set; } = default!;
  [Parameter] public EventCallback<string?> ValueChanged { get; set; }

  [Parameter] public bool DisableOnSelected { get; set; }

  private async Task Select(string id)
  {
    Value = id;
    await ValueChanged.InvokeAsync(id);
  }
}
