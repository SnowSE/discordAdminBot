@using Web.Models.Snow
@using Web.Services
@inject SnowCourseService Snow

<div class=" ">

  <input id="course-search-input" @ref="_searchInputElement" class="form-control mb-3"
         placeholder="Search by course, professor, or email…" @oninput="OnSearchInput" @attributes="_initialAttributes" />

  @if (ShowTermSelector)
  {
    <div class="d-flex align-items-center gap-3 mb-3">
      <div class="text-muted small">Term:</div>
      <div class="d-flex gap-2">
        @foreach (var term in _availableTerms)
        {
          <button class="btn btn-sm @(_selectedTermCode == term.TermCode ? "btn-secondary" : "btn-outline-secondary")"
                  @onclick="() => SetTermAsync(term.TermCode)">
            @term.DisplayName
          </button>
        }
      </div>
    </div>
  }

  @if (_courses.Count == 0)
  {
    <p class="text-muted">No courses found for the selected term.</p>
  }
  else
  {
    <div class="d-flex flex-wrap gap-3 mb-3">
      @foreach (var course in _filteredCourses.Take(20))
      {
        bool isAssigned = AssignedCrns?.Contains(course.Crn) == true;
        <CourseCard Course="course" IsConfigured="isAssigned" OnSelect="() => SelectCourseAsync(course)" />
      }
    </div>

    @if (_filteredCourses.Count == 0)
    {
      <p class="text-muted">No courses match your search.</p>
    }
  }
</div>

@code {
  [Parameter] public EventCallback<SnowCourse> OnCourseSelected { get; set; }
  [Parameter] public HashSet<SnowCrn>? AssignedCrns { get; set; }
  [Parameter] public bool ShowTermSelector { get; set; } = true;
  [Parameter] public SnowTermCode? InitialTermCode { get; set; }
  [Parameter] public string? InitialSearchQuery { get; set; }

  private List<SnowCourse> _courses = [];
  private List<SnowCourse> _filteredCourses = [];
  private List<(SnowTermCode TermCode, string DisplayName)> _availableTerms = [];
  private SnowTermCode? _selectedTermCode;

  private string _filter = "";
  private string _pendingFilter = "";
  private CancellationTokenSource? _debounceCancellation;
  private ElementReference _searchInputElement;
  private IDictionary<string, object>? _initialAttributes;

  private static readonly HashSet<string> DefaultDepartments = new(["SE", "CS", "ENGR"]);

  private List<SnowCourse> BuildFilteredCourses()
  {
    var query = _filter.Trim();
    var result = _courses.Where(course =>
      _selectedTermCode is null || course.Term.Code == _selectedTermCode
    );

    if (string.IsNullOrWhiteSpace(query))
    {
      return result
        .OrderBy(course => DefaultDepartments.Contains(course.SubjectCode.Value) ? 0 : 1)
        .ThenBy(course => course.SubjectCode.Value)
        .ThenBy(course => course.CourseNumber.Value)
        .Take(15)
        .ToList();
    }

    var scored = result.Select(course => (
      Course: course,
      Score: FuzzyMatcher.ScoreCourse(course, query)
    ));

    return scored
      .Where(scoredCourse => scoredCourse.Score > 0)
      .OrderByDescending(scoredCourse => scoredCourse.Score)
      .ThenBy(scoredCourse =>
        DefaultDepartments.Contains(scoredCourse.Course.SubjectCode.Value) ? 0 : 1
      )
      .ThenBy(scoredCourse => scoredCourse.Course.SubjectCode.Value)
      .ThenBy(scoredCourse => scoredCourse.Course.CourseNumber.Value)
      .Select(scoredCourse => scoredCourse.Course)
      .ToList();
  }

  protected override void OnInitialized()
  {
    SnowCourseService.DataChanged += OnDataChanged;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      await _searchInputElement.FocusAsync();

      if (!string.IsNullOrWhiteSpace(InitialSearchQuery))
      {
        _filter = InitialSearchQuery;
        _pendingFilter = InitialSearchQuery;
        _initialAttributes = new Dictionary<string, object>
        {
          ["value"] = InitialSearchQuery,
        };
        _filteredCourses = BuildFilteredCourses();
        StateHasChanged();
      }
    }
  }

  public override async Task SetParametersAsync(ParameterView parameters)
  {
    await base.SetParametersAsync(parameters);
    await HydrateCoursesAsync();
  }

  public void Dispose()
  {
    SnowCourseService.DataChanged -= OnDataChanged;
    _debounceCancellation?.Cancel();
    _debounceCancellation?.Dispose();
  }

  private async Task OnDataChanged()
  {
    await InvokeAsync(async () =>
    {
      await HydrateCoursesAsync();
      StateHasChanged();
    });
  }

  private async Task HydrateCoursesAsync()
  {
    var (terms, currentIndex) = SnowCourseService.GenerateTermOptionsWithCurrent();
    var courseTasks = terms
      .Select(term => Snow.GetCoursesForTermAsync(term.TermCode))
      .ToList();
    var results = await Task.WhenAll(courseTasks);
    _courses = [.. results.SelectMany(termCourses => termCourses)];
    _availableTerms = terms
      .Where(term => _courses.Any(course => course.Term.Code == term.TermCode))
      .ToList();

    if (_selectedTermCode is null)
    {
      if (
        InitialTermCode is not null
        && _availableTerms.Any(term => term.TermCode == InitialTermCode)
      )
      {
        _selectedTermCode = InitialTermCode;
      }
      else if (_availableTerms.Count > currentIndex)
      {
        _selectedTermCode = _availableTerms[currentIndex].TermCode;
      }
    }

    _filteredCourses = BuildFilteredCourses();
  }

  private void OnSearchInput(ChangeEventArgs changeEvent)
  {
    _pendingFilter = changeEvent.Value?.ToString() ?? "";
    _debounceCancellation?.Cancel();
    _debounceCancellation?.Dispose();
    _debounceCancellation = new CancellationTokenSource();
    var debounceToken = _debounceCancellation.Token;

    _ = ApplyDebouncedFilterAfterDelayAsync(debounceToken);
  }

  private async Task ApplyDebouncedFilterAfterDelayAsync(CancellationToken debounceToken)
  {
    try
    {
      await Task.Delay(250, debounceToken);
      await ApplyDebouncedFilterAsync(debounceToken);
    }
    catch (TaskCanceledException)
    {
    }
  }

  private async Task ApplyDebouncedFilterAsync(CancellationToken debounceToken)
  {
    if (debounceToken.IsCancellationRequested)
      return;

    _filter = _pendingFilter;
    _filteredCourses = BuildFilteredCourses();
    await InvokeAsync(StateHasChanged);
  }

  private async Task SelectCourseAsync(SnowCourse course)
  {
    await OnCourseSelected.InvokeAsync(course);
  }

  private void SetTermAsync(SnowTermCode termCode)
  {
    _selectedTermCode = termCode;
    _filteredCourses = BuildFilteredCourses();
    StateHasChanged();
  }

}
