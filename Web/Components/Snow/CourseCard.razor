@using Web.Models.Snow

<button class="card text-start border @(IsConfigured ? "opacity-50" : "hover-card") p-0"
        style="width:220px; cursor:@(IsConfigured ? "default" : "pointer")" disabled="@IsConfigured" @onclick="OnSelect">
  <div class="card-body p-3">
    <div class="d-flex justify-content-between align-items-start mb-1">
      <span class="font-monospace text-muted">
        @Course.SubjectCode @Course.CourseNumber – @Course.SectionNumber
      </span>
      @if (IsConfigured)
      {
        <span class="badge bg-secondary ms-1">Channel set</span>
      }
    </div>
    <div class="fw-semibold mb-2" style="line-height:1.25">@Course.Name</div>
    <div class="text-muted">@(_primaryInstructor?.Name ?? "—")</div>
    <div class="d-flex justify-content-between text-muted mt-2">
      <span>@_meetSummary</span>
      <span>@Course.Enrollment.Enrolled / @Course.Enrollment.Max</span>
    </div>
  </div>
</button>

@code {
  [Parameter, EditorRequired] public SnowCourse Course { get; set; } = default!;
  [Parameter] public bool IsConfigured { get; set; }
  [Parameter] public EventCallback OnSelect { get; set; }

  private SnowInstructor? _primaryInstructor =>
    Course.Instructors.FirstOrDefault(i => i.PrimaryInstructor) ?? Course.Instructors.FirstOrDefault();

  private string _meetSummary
  {
    get
    {
      var meet = Course.MeetInfo.FirstOrDefault();
      if (meet is null) return "—";
      var days = meet.Days.Count > 0 ? string.Concat(meet.Days.Select(d => d[..1])) : "—";
      var time = meet.StartTime is not null ? meet.StartTime : "";
      return $"{days} {time}".Trim();
    }
  }
}
