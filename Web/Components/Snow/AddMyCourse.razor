@using Microsoft.JSInterop
@using Web.Models
@using Web.Models.Snow
@using Web.Services
@inject DiscordService Discord
@rendermode InteractiveServer

<div class="add-course-form p-2 rounded">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Adding Chat for Course</h3>
    <button class="btn btn-outline-secondary" @onclick="OnCancel">Cancel</button>
  </div>

  <SearchForCourse AssignedCrns="_assignedCrns" OnCourseSelected="SelectCourse" />

  @if (_selectedCourse is not null)
  {
    <div class="card mb-4" style="max-width:480px">
      <div class="card-header py-2 d-flex justify-content-between align-items-center">
        <strong>@_selectedCourse.SubjectCode @_selectedCourse.CourseNumber – @_selectedCourse.SectionNumber</strong>
        <span class="text-muted">@_selectedCourse.Name</span>
      </div>
      <div class="card-body">

        <div class="mb-3">
          <label class="form-label mb-1">Channel name (human readable)</label>
          <input class="form-control font-monospace" @bind="_channelName" />
        </div>

        <div class="mb-3">
          <label class="form-label mb-1">Category (Graduating Class to group by)</label>
          <ButtonGroup @bind-Value="_selectedCategoryId" Options="_categories" IdSelector="c => c.Id.Value"
                       LabelSelector="c => c.Name?.Value ?? c.Id.Value" />
          <button class="btn btn-outline-secondary mt-2" @onclick="() => _showNewCategory = true">
            + New category…
          </button>
          @if (_showNewCategory)
          {
            <input class="form-control mt-2" placeholder="Category name" @bind="_newCategoryName" />
          }
        </div>

        <div class="mb-3">
          <label class="form-label mb-1">Student role (permission visibility)</label>
          <ButtonGroup @bind-Value="_selectedRoleId" Options="_roles" IdSelector="r => r.Id"
                       LabelSelector="r => r.Name" />
        </div>

        <div class="mb-3 form-check">
          <input type="checkbox" class="form-check-input" id="isPrivateCheckbox" @bind="_isPrivate" />
          <label class="form-check-label" for="isPrivateCheckbox">
            Private (@(_showNewCategory ? "category and channel" : "channel") will require role access)
          </label>
        </div>

        @if (_errorMessage is not null)
        {
          <div class="text-danger mb-2">@_errorMessage</div>
        }

        <button class="btn btn-primary" disabled="@_saving || _selectedCourse is null" @onclick="SetupChannelAsync">
          @if (_saving)
          {
            <span class="spinner-border spinner-border-sm me-1"></span>
          }
          Create Channel
        </button>
      </div>
    </div>
  }
</div>

@code {
  [CascadingParameter] protected LoadingBoundaryContext? Loading { get; set; }
  [Parameter] public EventCallback OnCancel { get; set; }

  private HashSet<SnowCrn> _assignedCrns = [];
  private List<GuildChannel> _categories = [];
  private List<GuildRole> _roles = [];
  private SnowCourse? _selectedCourse;
  private string _channelName = "";
  private string _selectedCategoryId = "";
  private bool _showNewCategory;
  private string _newCategoryName = "";
  private string _selectedRoleId = "";
  private bool _isPrivate = true;
  private bool _saving;
  private string? _errorMessage;

  protected override async Task OnInitializedAsync()
  {
    DiscordService.DbDataChanged += HydrateDiscordAsync;
    using (Loading?.Start())
    {
      await HydrateDiscordAsync();
    }
  }

  public void Dispose()
  {
    DiscordService.DbDataChanged -= HydrateDiscordAsync;
  }

  private async Task HydrateDiscordAsync()
  {
    var channelsTask = Discord.GetChannelsAsync();
    var rolesTask = Discord.GetRolesAsync();
    var assignmentsTask = Discord.GetCourseChannelAssignmentsAsync();
    await Task.WhenAll(channelsTask, rolesTask, assignmentsTask);

    _categories = [.. channelsTask.Result.Where(c => c.Type == 4).OrderBy(c => (int?)c.Position ?? int.MaxValue)];
    _roles = [.. rolesTask.Result
      .Where(r => !r.Managed && r.Name != "@everyone")
      .OrderByDescending(r => r.Position)];
    _assignedCrns = [.. assignmentsTask.Result.Select(a => a.Crn)];

    if (_selectedCategoryId == "" && _categories.Count > 0)
      _selectedCategoryId = _categories[0].Id.Value;

    await InvokeAsync(StateHasChanged);
  }

  private void SelectCourse(SnowCourse course)
  {
    _selectedCourse = course;
    _errorMessage = null;

    var termCode = course.Term.Code.Value;
    var year = termCode.Length >= 4 ? termCode[..4] : termCode;
    var semesterSlug = termCode.Length >= 6 ? termCode[4..] switch
    {
      "10" => "spring",
      "30" => "summer",
      "40" => "fall",
      var s => s,
    } : "";

    _channelName = $"{course.SubjectCode.Value.ToLower()}-{course.CourseNumber.Value}-{year}-{semesterSlug}";
  }

  private async Task SetupChannelAsync()
  {
    if (_selectedCourse is null)
      return;

    if (string.IsNullOrWhiteSpace(_channelName))
    {
      _errorMessage = "Channel name is required when creating a new course channel.";
      return;
    }

    if (string.IsNullOrWhiteSpace(_selectedRoleId))
    {
      _errorMessage = "Please select a student role for the course channel.";
      return;
    }

    if (string.IsNullOrWhiteSpace(_selectedCategoryId) && !_showNewCategory)
    {
      _errorMessage = "Please select or create a category for the course channel.";
      return;
    }

    string? categoryNameForNewCategory = null;
    if (_showNewCategory)
    {
      if (string.IsNullOrWhiteSpace(_newCategoryName))
      {
        _errorMessage = "Enter a name for the new category before creating a channel.";
        return;
      }
      categoryNameForNewCategory = _newCategoryName.Trim();
    }

    _saving = true;
    _errorMessage = null;

    try
    {
      DiscordChannelId? existingCategoryId = _showNewCategory ? null : new DiscordChannelId(_selectedCategoryId);

      await Discord.SetupCourseChannelAsync(
        _selectedCourse.Crn,
        _selectedCourse.Term.Code,
        _channelName,
        existingCategoryId,
        categoryNameForNewCategory,
        new DiscordRoleId(_selectedRoleId),
        _isPrivate
      );

      _selectedCourse = null;
      _channelName = "";
      _newCategoryName = "";
      _isPrivate = true;
      _showNewCategory = false;
    }
    catch (Exception ex)
    {
      _errorMessage = $"Failed to create channel: {ex.Message}";
    }
    finally
    {
      _saving = false;
    }
  }
}
