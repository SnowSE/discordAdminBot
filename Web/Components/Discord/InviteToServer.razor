@using Web.Models
@using Web.Services
@using Web.Components.Shared
@inject DiscordService Discord
@rendermode InteractiveServer

<div class="card">
  <div class="card-header">
    <h5 class="mb-0">Server Invite</h5>
  </div>
  <div class="card-body">
    @if (_shares.Count > 0)
    {
      @foreach (var share in _shares)
      {
        var channelName = share.Channel?.Name?.Value ?? "Unknown";
        <div class="input-group mb-2">
          <span class="input-group-text">#@channelName</span>
          <input type="text" class="form-control" readonly value="@share.Url" />
          <button type="button" class="btn btn-outline-secondary"
                  @onclick="() => CopyToClipboardAsync(share.Url)">Copy</button>
          <button type="button" class="btn btn-outline-danger" @onclick="() => DeleteShareAsync(share.Code)">Delete</button>
        </div>
      }
    }
    else
    {
      <form @onsubmit="GenerateInviteAsync" @onsubmit:preventDefault>
        <div class="input-group">
          <select class="form-select" @bind="_selectedChannelId">
            <option value="">-- select a channel --</option>
            @foreach (var c in _channels.Where(c => c.Type != 4).OrderBy(c => (int?)c.Position ?? int.MaxValue))
            {
              if (c.Name != null)
              {
                <option value="@c.Id">@c.Name (@c.TypeName)</option>
              }
            }
          </select>
          <button type="submit" class="btn btn-primary"
                  disabled="@(_generating || string.IsNullOrWhiteSpace(_selectedChannelId))">
            @if (_generating)
            {
              <span class="spinner-border spinner-border-sm me-1"></span>
            }
            Generate Invite
          </button>
        </div>
      </form>
    }
  </div>
</div>

@code {
  [CascadingParameter]
  protected LoadingBoundaryContext? Loading { get; set; }

  private List<GuildChannel> _channels = [];
  private List<DiscordInvite> _shares = [];
  private string? _selectedChannelId;
  private bool _generating = false;

  protected override async Task OnInitializedAsync()
  {
    DiscordService.DbDataChanged += Hydrate;
    using (Loading?.Start())
    {
      await Hydrate();
    }
  }

  public void Dispose()
  {
    DiscordService.DbDataChanged -= Hydrate;
  }

  private async Task Hydrate()
  {
    _channels = await Discord.GetChannelsAsync();
    _shares = await Discord.GetSharesAsync();

    await InvokeAsync(StateHasChanged);
  }

  private async Task GenerateInviteAsync()
  {
    if (string.IsNullOrWhiteSpace(_selectedChannelId))
      return;

    _generating = true;
    await Discord.GenerateShareAsync(_selectedChannelId);
    _generating = false;
  }

  private async Task DeleteShareAsync(InviteCode code)
  {
    await Discord.DeleteShareAsync(code);
  }

  private Task CopyToClipboardAsync(string text) => Task.CompletedTask;
}
