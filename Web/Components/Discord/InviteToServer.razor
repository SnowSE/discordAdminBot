@using Microsoft.JSInterop
@using Web.Models
@using Web.Services
@using Web.Components.Shared
@inject DiscordService Discord
@inject IJSRuntime JS
@rendermode InteractiveServer

<script>
  window.copyInvite = function (text) {
    return navigator.clipboard.writeText(text);
  };
</script>

<div class="bg-body-secondary p-3 rounded border border-light mb-4">
  <h5 class="mb-0">Server Invite (share this code with your class in a canvas assignment or something)</h5>
  <div style="max-width: 48rem;">
    @if (_shares.Count > 0)
    {
      @foreach (var share in _shares)
      {
        var channelName = share.Channel?.Name?.Value ?? "Unknown";
        <div class="input-group mb-2">
          <span class="input-group-text">#@channelName</span>
          <input type="text" class="form-control" readonly value="@share.Url" />
          <button type="button" class="btn btn-outline-primary" @onclick="() => CopyInviteAsync(share)"
                  title="Copy to clipboard">
            @if (_copiedShareCodes.Contains(share.Code))
            {
              <span>Copied</span>
            }
            else
            {
              <span>Copy</span>
            }
          </button>
        </div>
      }
    }
    else
    {
      <form @onsubmit="GenerateInviteAsync" @onsubmit:preventDefault>
        <div class="input-group">
          <select class="form-select" @bind="_selectedChannelId">
            <option value="">-- select a channel --</option>
            @foreach (var c in _channels.Where(c => c.Type != 4).OrderBy(c => (int?)c.Position ?? int.MaxValue))
            {
              if (c.Name != null)
              {
                <option value="@c.Id">@c.Name (@c.TypeName)</option>
              }
            }
          </select>
          <button type="submit" class="btn btn-primary"
                  disabled="@(_generating || string.IsNullOrWhiteSpace(_selectedChannelId))">
            @if (_generating)
            {
              <span class="spinner-border spinner-border-sm me-1"></span>
            }
            Generate Invite
          </button>
        </div>
      </form>
    }
  </div>
</div>

@code {
  [CascadingParameter]
  protected LoadingBoundaryContext? Loading { get; set; }

  private List<GuildChannel> _channels = [];
  private List<DiscordInvite> _shares = [];
  private HashSet<InviteCode> _copiedShareCodes = [];
  private string? _selectedChannelId;
  private bool _generating = false;

  protected override async Task OnInitializedAsync()
  {
    DiscordService.DbDataChanged += Hydrate;
    using (Loading?.Start())
    {
      await Hydrate();
    }
  }

  public void Dispose()
  {
    DiscordService.DbDataChanged -= Hydrate;
  }

  private async Task Hydrate()
  {
    _channels = await Discord.GetChannelsAsync();
    _shares = await Discord.GetSharesAsync();

    await InvokeAsync(StateHasChanged);
  }

  private async Task GenerateInviteAsync()
  {
    if (string.IsNullOrWhiteSpace(_selectedChannelId))
      return;

    _generating = true;
    await Discord.GenerateShareAsync(_selectedChannelId);
    _generating = false;
  }

  private async Task CopyInviteAsync(DiscordInvite share)
  {
    await JS.InvokeVoidAsync("window.copyInvite", share.Url);
    _copiedShareCodes.Add(share.Code);
    StateHasChanged();
  }

}
