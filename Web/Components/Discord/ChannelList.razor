@using Web.Models
@using Web.Models.Snow
@using Web.Services
@using Web.Components.Shared
@using Web.Components.Snow
@inject DiscordService Discord
@inject SnowCourseService Snow

<div class="">
  <div class="d-flex align-items-center justify-content-between mb-2">
    <h3 class="mb-0">Channels</h3>
    @if (_courseChannels.Any())
    {
      <button class="btn btn-sm btn-outline-primary" @onclick="OpenSyncAllModal">
        Sync All Courses
      </button>
    }
  </div>

  @if (_showSyncModal)
  {
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Sync All Course Channels</h5>
            <button type="button" class="btn-close" @onclick="CloseSyncAllModal"></button>
          </div>
          <div class="modal-body">
            <JwtInput @bind-Token="_syncModel.JwtToken" />
            @if (_syncError is not null)
            {
              <div class="alert alert-danger small py-2 mb-3">@_syncError</div>
            }
            <div class="d-flex gap-2 justify-content-end">
              <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseSyncAllModal">Cancel</button>
              <button type="button" class="btn btn-primary btn-sm" disabled="@_syncing" @onclick="SyncAllAsync">
                @if (_syncing)
                {
                  <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Sync @_courseChannels.Count Course@(_courseChannels.Count != 1 ? "s" : "")
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  }

  <div class="">
    @foreach (var category in _categories)
    {
      var children = _channelsByCategory.GetValueOrDefault(category?.Id?.Value ?? "", []);
      <div class="px-3 pt-2 pb-1">
        <div class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing:.05em">
          @(category?.Name?.Value ?? "Uncategorized")
        </div>
        @foreach (var channel in children)
        {
          var courseInfo = _coursesByChannelId.GetValueOrDefault(channel.Id.Value);
          var syncInfo = _syncStatusByChannelId.GetValueOrDefault(channel.Id.Value);
          var assignment = _courseChannels.FirstOrDefault(a => a.DiscordChannelId == channel.Id);
          var isExpanded = _expandedChannels.Contains(channel.Id.Value);
          <div>
            <div class="d-flex align-items-center gap-2 py-1 px-4"
                 style="cursor: @(assignment is not null ? "pointer" : "default")"
                 @onclick="() => { if (assignment is not null) ToggleChannel(channel.Id.Value); }">
              @if (assignment is not null)
              {
                <span class="small">@(isExpanded ? "▼" : "▶")</span>
              }
              <span>#@(channel.Name?.Value ?? "unnamed")</span>
              <span class="text-muted small">@channel.TypeName</span>
              @if (courseInfo is not null)
              {
                <span class="badge bg-secondary" style="font-size:.7rem">@courseInfo</span>
                @if (syncInfo is not null)
                {
                  <span class="badge bg-info text-dark" style="font-size:.65rem">@syncInfo</span>
                }
                else
                {
                  <span class="badge bg-warning text-dark" style="font-size:.65rem">unsynced</span>
                }
              }
            </div>
            @if (isExpanded && assignment is not null)
            {
              <div class="ms-5 me-3">
                <StudentMappingForChannel Assignment="assignment" Mappings="_mappings" Members="_members" Roles="_roles"
                                          OnMappingChanged="ReloadMappingsAsync" />

                <div class="mb-2">
                  <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteChannelConfirmation(assignment)">
                    Delete Channel
                  </button>
                  @if (_channelToDelete == assignment)
                  {
                    <div class="mt-2 small text-warning">
                      This will permanently delete the Discord channel and remove the course assignment. Continue?
                      <button class="btn btn-sm btn-danger ms-2" @onclick="() => DeleteChannelAsync(assignment)">
                        Yes, delete
                      </button>
                      <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="CancelDelete">
                        Cancel
                      </button>
                    </div>
                  }
                </div>
              </div>
            }
          </div>
        }
      </div>
    }
  </div>
</div>

@code {
  [CascadingParameter]
  protected LoadingBoundaryContext? Loading { get; set; }

  private List<GuildChannel?> _categories = [];
  private Dictionary<string, List<GuildChannel>> _channelsByCategory = [];
  private Dictionary<string, string> _coursesByChannelId = [];
  private Dictionary<string, string> _syncStatusByChannelId = [];
  private List<CourseChannelAssignment> _courseChannels = [];
  private List<(SnowBadgerId BadgerId, DiscordUserId DiscordUserId)> _mappings = [];
  private List<GuildMember> _members = [];
  private List<GuildRole> _roles = [];
  private HashSet<string> _expandedChannels = [];
  private bool _showSyncModal;
  private bool _syncing;
  private string? _syncError;
  private readonly SyncModel _syncModel = new();
  private CourseChannelAssignment? _channelToDelete;

  protected override async Task OnInitializedAsync()
  {
    DiscordService.DbDataChanged += HydrateAsync;
    SnowCourseService.DataChanged += HydrateAsync;
    using (Loading?.Start())
    {
      await HydrateAsync();
    }
  }

  public void Dispose()
  {
    DiscordService.DbDataChanged -= HydrateAsync;
    SnowCourseService.DataChanged -= HydrateAsync;
  }

  private async Task HydrateAsync()
  {
    using var _ = Loading?.Start();

    var (channels, assignments, terms) = await FetchBaseDataAsync();
    var (courseNames, syncTimes, mappings, members, roles) = await FetchDisplayDataAsync(assignments);

    _courseChannels = assignments;
    _categories = BuildCategories(channels);
    _channelsByCategory = BuildChannelsByCategory(channels);
    _coursesByChannelId = BuildCourseLookup(assignments, courseNames);
    _syncStatusByChannelId = BuildSyncStatusLookup(assignments, syncTimes);
    _mappings = mappings;
    _members = members;
    _roles = roles;
  }

  private async Task<(List<GuildChannel>, List<CourseChannelAssignment>, List<SnowTerm>)> FetchBaseDataAsync()
  {
    var channelsTask = Discord.GetChannelsAsync();
    var assignmentsTask = Discord.GetCourseChannelAssignmentsAsync();
    var termsTask = Snow.GetTermsAsync();
    await Task.WhenAll(channelsTask, assignmentsTask, termsTask);

    return (channelsTask.Result, assignmentsTask.Result, termsTask.Result);
  }

  private async Task<(Dictionary<(SnowCrn, SnowTermCode), string?>, Dictionary<(SnowCrn, SnowTermCode), DateTime?>,
List<(SnowBadgerId, DiscordUserId)>, List<GuildMember>, List<GuildRole>)> FetchDisplayDataAsync(
    List<CourseChannelAssignment> assignments)
  {
    var courseNamesTask = Snow.GetCourseNamesBatchAsync(assignments);
    var syncTimesTask = Snow.GetSyncTimesBatchAsync(assignments);
    var mappingsTask = Discord.GetStudentDiscordMappingsAsync();
    var membersTask = Discord.GetMembersAsync();
    var rolesTask = Discord.GetRolesAsync();
    await Task.WhenAll(courseNamesTask, syncTimesTask, mappingsTask, membersTask, rolesTask);

    return (
      courseNamesTask.Result,
      syncTimesTask.Result,
      mappingsTask.Result,
      membersTask.Result,
      rolesTask.Result
    );
  }

  private List<GuildChannel?> BuildCategories(List<GuildChannel> channels)
  {
    var categoryChannels = channels.Where(c => c.Type == 4).OrderBy(c => (int?)c.Position ?? int.MaxValue).ToList();
    return [.. categoryChannels.Cast<GuildChannel?>(), .. (ShouldShowUncategorized(channels) ? [null] :
Array.Empty<GuildChannel?>())];
  }

  private bool ShouldShowUncategorized(List<GuildChannel> channels)
  {
    var categoryIds = channels.Where(c => c.Type == 4).Select(c => c.Id.Value).ToHashSet();
    return channels.Any(c => c.Type != 4 && (c.ParentId is null || !categoryIds.Contains(c.ParentId.Value)));
  }

  private Dictionary<string, List<GuildChannel>> BuildChannelsByCategory(List<GuildChannel> channels)
  {
    return channels.Where(c => c.Type != 4)
      .OrderBy(c => (int?)c.Position ?? int.MaxValue)
      .GroupBy(c => c.ParentId?.Value ?? "")
      .ToDictionary(g => g.Key, g => g.ToList());
  }

  private Dictionary<string, string> BuildCourseLookup(
    List<CourseChannelAssignment> assignments,
    Dictionary<(SnowCrn, SnowTermCode), string?> courseNames)
  {
    return assignments
      .Select(a => (a.DiscordChannelId.Value, CourseName: courseNames.GetValueOrDefault((a.Crn, a.TermCode))))
      .Where(r => r.CourseName is not null)
      .ToDictionary(r => r.Item1, r => r.CourseName!);
  }

  private Dictionary<string, string> BuildSyncStatusLookup(
    List<CourseChannelAssignment> assignments,
    Dictionary<(SnowCrn, SnowTermCode), DateTime?> syncTimes)
  {
    return assignments
      .Select(a => (a.DiscordChannelId.Value, Status: DiscordService.FormatSyncStatus(syncTimes.GetValueOrDefault((a.Crn,
a.TermCode)))))
      .Where(r => r.Status is not null)
      .ToDictionary(r => r.Item1, r => r.Status!);
  }


  private void OpenSyncAllModal()
  {
    _showSyncModal = true;
    _syncError = null;
  }

  private void CloseSyncAllModal()
  {
    _showSyncModal = false;
    _syncError = null;
  }

  private async Task SyncAllAsync()
  {
    if (string.IsNullOrWhiteSpace(_syncModel.JwtToken))
    {
      _syncError = "Enter JWT token before syncing channels.";
      return;
    }

    _syncing = true;
    _syncError = null;
    StateHasChanged();

    try
    {
      foreach (var assignment in _courseChannels)
      {
        await Discord.SyncCourseChannelAsync(assignment.Crn, assignment.TermCode, _syncModel.JwtToken.Trim());
      }
      await HydrateAsync();
      CloseSyncAllModal();
    }
    catch (Exception ex)
    {
      _syncError = $"Sync failed: {ex.Message}";
    }
    finally
    {
      _syncing = false;
      StateHasChanged();
    }
  }

  private async Task ReloadMappingsAsync()
  {
    using var _ = Loading?.Start();
    _mappings = await Discord.GetStudentDiscordMappingsAsync();
    StateHasChanged();
  }

  private void ToggleChannel(string channelId)
  {
    if (_expandedChannels.Contains(channelId))
      _expandedChannels.Remove(channelId);
    else
      _expandedChannels.Add(channelId);
    StateHasChanged();
  }

  private void DeleteChannelConfirmation(CourseChannelAssignment assignment)
  {
    _channelToDelete = assignment;
    StateHasChanged();
  }

  private void CancelDelete()
  {
    _channelToDelete = null;
    StateHasChanged();
  }

  private async Task DeleteChannelAsync(CourseChannelAssignment assignment)
  {
    _channelToDelete = null;
    StateHasChanged();

    using (Loading?.Start())
    {
      try
      {
        await Discord.DeleteCourseChannelAsync(assignment.Crn);
      }
      catch (Exception ex)
      {
        _syncError = $"Failed to delete channel: {ex.Message}";
      }
    }
  }

  private sealed class SyncModel
  {
    public string? JwtToken { get; set; }
  }
}
