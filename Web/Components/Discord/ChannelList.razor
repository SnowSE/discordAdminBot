@using Web.Components.Shared.Icons
@using Web.Models
@using Web.Models.Snow
@using Web.Services
@using Web.Components.Shared
@using Web.Components.Discord.StudentMapping
@inject DiscordService Discord
@inject SnowCourseService Snow

<div class="p-3 rounded mb-4">

  @foreach (var category in _categories)
  {
    var children = _channelsByCategory.GetValueOrDefault(category?.Id?.Value ?? "", []);
    <div class="category-card bg-white border mb-4 rounded p-3">
      <div class="d-flex align-items-center gap-3 text-muted text-uppercase fw-semibold mb-3"
           style="letter-spacing:.05em; font-size: 0.875rem">
        @(category?.Name?.Value ?? "Uncategorized")
        @if (category is not null)
        {
          @if (IsCategoryPrivate(category))
          {
            <LockIcon CssClass="text-secondary" Title="Private category - requires role access" />
            @foreach (var overwriteRoleName in GetAccessibleRoleNames(category))
            {
              <span class="badge text-bg-secondary" style="font-size:0.75rem">@overwriteRoleName</span>
            }
          }
          else
          {
            <GlobeIcon CssClass="text-muted" Title="Visible to everyone" />
          }
          @if (!HasSharingVoiceChannel(children))
          {
            <button type="button" class="btn btn-sm btn-outline-secondary" style="font-size:0.75rem"
                    @onclick="() => AddSharingVoiceChannelAsync(category.Id)" title="Add sharing voice channel">
              <PlusIcon CssClass="me-1" Style="margin-top:-1px" />
              Add Sharing Voice Channel
            </button>
          }
        }
      </div>
      @foreach (var channel in children)
      {
        var assignment = _courseChannels.FirstOrDefault(a => a.DiscordChannelId == channel.Id);
        <ChannelListItem Channel="channel" Assignment="assignment"
                         CourseInfo="@_coursesByChannelId.GetValueOrDefault(channel.Id.Value)"
                         SyncInfo="@_syncStatusByChannelId.GetValueOrDefault(channel.Id.Value)"
                         UnmappedStudentCount="GetUnmappedCount(assignment)" RoleOverwrites="GetRoleOverwrites(channel)"
                         MappedIds="_mappings" AllMembers="_members" AllRoles="_roles" OnMappingChanged="ReloadMappingsAsync"
                         OnDeleteRequested="HandleDeleteChannelAsync" />
      }
    </div>
  }
</div>

@code {
  [CascadingParameter]
  protected LoadingBoundaryContext? Loading { get; set; }

  private List<GuildChannel?> _categories = [];
  private Dictionary<string, List<GuildChannel>> _channelsByCategory = [];
  private Dictionary<string, string> _coursesByChannelId = [];
  private Dictionary<string, string> _syncStatusByChannelId = [];
  private List<CourseChannelAssignment> _courseChannels = [];
  private List<(SnowBadgerId BadgerId, DiscordUserId DiscordUserId)> _mappings = [];
  private List<GuildMember> _members = [];
  private List<GuildRole> _roles = [];
  private Dictionary<(SnowCrn, SnowTermCode), int> _unmappedCounts = [];

  protected override async Task OnInitializedAsync()
  {
    DiscordService.DbDataChanged += HydrateAsync;
    DiscordService.StudentMappingChanged += OnStudentMappingChangedAsync;
    SnowCourseService.DataChanged += HydrateAsync;
    using (Loading?.Start())
    {
      await HydrateAsync();
    }
  }

  public void Dispose()
  {
    DiscordService.DbDataChanged -= HydrateAsync;
    DiscordService.StudentMappingChanged -= OnStudentMappingChangedAsync;
    SnowCourseService.DataChanged -= HydrateAsync;
  }

  private async Task HydrateAsync()
  {
    using var _ = Loading?.Start();

    var (channels, assignments, terms) = await FetchBaseDataAsync();
    var (courseNames, syncTimes, mappings, members, roles) = await FetchDisplayDataAsync(assignments);

    _courseChannels = assignments;
    _categories = BuildCategories(channels);
    _channelsByCategory = BuildChannelsByCategory(channels);
    _coursesByChannelId = BuildCourseLookup(assignments, courseNames);
    _syncStatusByChannelId = BuildSyncStatusLookup(assignments, syncTimes);
    _mappings = mappings;
    _members = members;
    _roles = roles;
    _unmappedCounts = await ComputeUnmappedCountsAsync(assignments, mappings);
  }

  private async Task<(List<GuildChannel>, List<CourseChannelAssignment>, List<SnowTerm>)> FetchBaseDataAsync()
  {
    var channelsTask = Discord.GetChannelsAsync();
    var assignmentsTask = Discord.GetCourseChannelAssignmentsAsync();
    var termsTask = Snow.GetTermsAsync();
    await Task.WhenAll(channelsTask, assignmentsTask, termsTask);

    return (channelsTask.Result, assignmentsTask.Result, termsTask.Result);
  }

  private async Task<(Dictionary<(SnowCrn, SnowTermCode), string?>, Dictionary<(SnowCrn, SnowTermCode), DateTime?>,
List<(SnowBadgerId, DiscordUserId)>, List<GuildMember>, List<GuildRole>)> FetchDisplayDataAsync(
    List<CourseChannelAssignment> assignments)
  {
    var courseNamesTask = Snow.GetCourseNamesBatchAsync(assignments);
    var syncTimesTask = Snow.GetSyncTimesBatchAsync(assignments);
    var mappingsTask = Discord.GetStudentDiscordMappingsAsync();
    var membersTask = Discord.GetMembersAsync();
    var rolesTask = Discord.GetRolesAsync();
    await Task.WhenAll(courseNamesTask, syncTimesTask, mappingsTask, membersTask, rolesTask);

    return (
      courseNamesTask.Result,
      syncTimesTask.Result,
      mappingsTask.Result,
      membersTask.Result,
      rolesTask.Result
    );
  }

  private async Task<Dictionary<(SnowCrn, SnowTermCode), int>> ComputeUnmappedCountsAsync(
    List<CourseChannelAssignment> assignments, List<(SnowBadgerId, DiscordUserId)> mappings)
  {
    var mappedBadgerIds = mappings.Select(m => m.Item1.Value).ToHashSet();
    return await Snow.GetUnmappedStudentCountsBatchAsync(assignments, mappedBadgerIds);
  }

  private int GetUnmappedCount(CourseChannelAssignment? assignment)
  {
    if (assignment is null)
      return 0;

    return _unmappedCounts.GetValueOrDefault((assignment.Crn, assignment.TermCode), 0);
  }

  private bool IsChannelPrivate(GuildChannel channel)
  {
    return channel.PermissionOverwrites?.Any(p => p.Type == PermissionOverwriteType.Role) == true;
  }

  private List<GuildChannel?> BuildCategories(List<GuildChannel> channels)
  {
    var categoryChannels = channels.Where(c => c.Type == 4).OrderBy(c => (int?)c.Position ?? int.MaxValue).ToList();
    return [.. categoryChannels.Cast<GuildChannel?>(), .. (ShouldShowUncategorized(channels) ? [null] :
Array.Empty<GuildChannel?>())];
  }

  private bool ShouldShowUncategorized(List<GuildChannel> channels)
  {
    var categoryIds = channels.Where(c => c.Type == 4).Select(c => c.Id.Value).ToHashSet();
    return channels.Any(c => c.Type != 4 && (c.ParentId is null || !categoryIds.Contains(c.ParentId.Value)));
  }

  private Dictionary<string, List<GuildChannel>> BuildChannelsByCategory(List<GuildChannel> channels)
  {
    return channels.Where(c => c.Type != 4)
      .OrderBy(c => (int?)c.Position ?? int.MaxValue)
      .GroupBy(c => c.ParentId?.Value ?? "")
      .ToDictionary(g => g.Key, g => g.ToList());
  }

  private Dictionary<string, string> BuildCourseLookup(
    List<CourseChannelAssignment> assignments,
    Dictionary<(SnowCrn, SnowTermCode), string?> courseNames)
  {
    return assignments
      .Select(a => (a.DiscordChannelId.Value, CourseName: courseNames.GetValueOrDefault((a.Crn, a.TermCode))))
      .Where(r => r.CourseName is not null)
      .ToDictionary(r => r.Item1, r => r.CourseName!);
  }

  private Dictionary<string, string> BuildSyncStatusLookup(
    List<CourseChannelAssignment> assignments,
    Dictionary<(SnowCrn, SnowTermCode), DateTime?> syncTimes)
  {
    return assignments
      .Select(a => (a.DiscordChannelId.Value, Status: DiscordService.FormatSyncStatus(syncTimes.GetValueOrDefault((a.Crn,
a.TermCode)))))
      .Where(r => r.Status is not null)
      .ToDictionary(r => r.Item1, r => r.Status!);
  }

  private List<string> GetRoleOverwrites(GuildChannel channel)
  {
    if (channel.PermissionOverwrites == null || !channel.PermissionOverwrites.Any())
      return [];

    var roleIds = channel.PermissionOverwrites
      .Where(p => p.Type == PermissionOverwriteType.Role)
      .Select(p => p.Id)
      .ToHashSet();

    return _roles.Where(r => roleIds.Contains(r.Id.Value))
      .OrderBy(r => r.Position)
      .Select(r => r.Name.Value)
      .ToList();
  }

  private List<string> GetAccessibleRoleNames(GuildChannel channel)
  {
    if (channel.PermissionOverwrites == null || !channel.PermissionOverwrites.Any())
      return [];

    const long viewChannelBit = 1L << 10;

    var roleIds = channel.PermissionOverwrites
      .Where(p => p.Type == PermissionOverwriteType.Role && (p.Deny & viewChannelBit) == 0)
      .Select(p => p.Id)
      .ToHashSet();

    return _roles.Where(r => roleIds.Contains(r.Id.Value))
      .OrderBy(r => r.Position)
      .Select(r => r.Name.Value)
      .ToList();
  }

  private bool IsCategoryPrivate(GuildChannel category)
  {
    if (category.PermissionOverwrites == null || !category.PermissionOverwrites.Any())
      return false;

    const long viewChannelBit = 1L << 10;

    return category.PermissionOverwrites.Any(p => p.Type == PermissionOverwriteType.Role && p.Deny != 0 && (p.Deny &
viewChannelBit) != 0);
  }



  private async Task OnStudentMappingChangedAsync()
  {
    using var _ = Loading?.Start();
    var assignments = await Discord.GetCourseChannelAssignmentsAsync();
    var mappings = await Discord.GetStudentDiscordMappingsAsync();
    _mappings = mappings;
    _unmappedCounts = await ComputeUnmappedCountsAsync(assignments, mappings);
    StateHasChanged();
  }

  private async Task HandleSyncCompletedAsync()
  {
    await HydrateAsync();
  }

  private async Task ReloadMappingsAsync()
  {
    using var _ = Loading?.Start();
    _mappings = await Discord.GetStudentDiscordMappingsAsync();
    StateHasChanged();
  }

  private async Task HandleDeleteChannelAsync(CourseChannelAssignment assignment)
  {
    using (Loading?.Start())
    {
      try
      {
        await Discord.DeleteCourseChannelAsync(assignment.Crn);
      }
      catch (Exception ex)
      {
        throw new InvalidOperationException($"Deleting course channel failed for CRN {assignment.Crn}: {ex.Message}", ex);
      }
    }
  }

  private static bool HasSharingVoiceChannel(List<GuildChannel> channels)
  {
    return channels.Any(c => c.Type == 2 && c.Name?.Value.ToLower() == "sharing");
  }

  private async Task AddSharingVoiceChannelAsync(DiscordChannelId categoryId)
  {
    using (Loading?.Start())
    {
      try
      {
        await Discord.CreateSharingVoiceChannelAsync(categoryId);
      }
      catch (Exception ex)
      {
        throw new InvalidOperationException($"Creating sharing voice channel failed for category {categoryId}: {ex.Message}",
ex);
      }
    }
  }

}
