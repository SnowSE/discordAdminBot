@using Web.Models
@using Web.Services

<div class="list-group-item d-flex justify-content-between align-items-center">
  <span class="text-truncate">@Member.DisplayName</span>
  @if (HasRole)
  {
    <form @onsubmit="RemoveFromRoleAsync" @onsubmit:preventDefault>
      <button type="submit" class="btn btn-outline-danger btn-sm" disabled="@_working">Remove</button>
    </form>
  }
  else
  {
    <form @onsubmit="AddToRoleAsync" @onsubmit:preventDefault>
      <button type="submit" class="btn btn-outline-primary btn-sm" disabled="@_working">Add</button>
    </form>
  }
</div>

@code {
  [Parameter]
  public GuildMember Member { get; set; } = default!;

  [Parameter]
  public GuildRole Role { get; set; } = default!;

  [Inject]
  private DiscordService Discord { get; set; } = default!;

  private DiscordUserId? UserId => Member?.User?.Id;
  private bool HasRole => Member.Roles.Contains(Role.Id);
  private bool _working = false;

  private async Task AddToRoleAsync()
  {
    if (Role.Id == null)
      throw new InvalidOperationException($"Cannot add role '{Role.Name}' to member '{Member.DisplayName}' — role has no ID.");
    var userId = UserId ?? throw new InvalidOperationException($"Cannot add role '{Role.Name}' ({Role.Id}) — member '{Member.DisplayName}' has no associated user.");
    _working = true;
    await Discord.AddRoleToMemberAsync(userId, Role.Id);
    await Discord.SyncMembersAsync();
    _working = false;
  }

  private async Task RemoveFromRoleAsync()
  {
    if (Role.Id == null)
      throw new InvalidOperationException($"Cannot remove role '{Role.Name}' from member '{Member.DisplayName}' — role has no ID.");
    var userId = UserId ?? throw new InvalidOperationException($"Cannot remove role '{Role.Name}' ({Role.Id}) — member '{Member.DisplayName}' has no associated user.");
    _working = true;
    await Discord.RemoveRoleFromMemberAsync(userId, Role.Id);
    await Discord.SyncMembersAsync();
    _working = false;
  }
}
