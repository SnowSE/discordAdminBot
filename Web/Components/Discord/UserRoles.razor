@using Web.Models
@using Web.Services
@using Web.Components.Shared
@inject DiscordService Discord

@if (_creatingRole)
{
  <div class="card mb-4" style="max-width:400px">
    <div class="card-header d-flex justify-content-between align-items-center">
      <strong>New Role</strong>
      <button type="button" class="btn-close btn-sm" aria-label="Close" @onclick="() => _creatingRole = false"></button>
    </div>
    <form @onsubmit="CreateRoleAsync" @onsubmit:preventDefault>
      <div class="card-body">
        <div class="mb-3">
          <label class="form-label">Name</label>
          <input @bind="_roleName" class="form-control" placeholder="Role name" />
        </div>
        <button type="submit" class="btn btn-primary btn-sm" disabled="@_creating">
          @if (_creating)
          {
            <span class="spinner-border spinner-border-sm me-1"></span>
          }
          Create
        </button>
      </div>
    </form>
  </div>
}
else
{
  <button type="button" class="btn btn-outline-primary btn-sm mb-3" @onclick="() => _creatingRole = true">
    + New Role
  </button>
}

<div class="row g-4">
  @foreach (var role in allRoles.Where(IsAssignableRole).OrderBy(r => r.Position))
  {
    <div class="col-md-6 col-lg-4">
      <div class="card h-100">
        <div class="card-header d-flex align-items-center gap-2">
          @if (role.Color != 0)
          {
            <span
            style="width:14px;height:14px;background:#@(role.Color.ToString("x6"));border-radius:50%;display:inline-block;flex-shrink:0"></span>
          }
          <strong class="text-truncate">@role.Name</strong>
        </div>

        <input type="text" class="card-header form-control border-top border-bottom bg-light"
               placeholder="Search members..."
               @oninput="(ChangeEventArgs e) => HandleSearch(role.Id, e.Value?.ToString() ?? string.Empty)" />

        <div class="list-group list-group-flush overflow-auto py-1" style="max-height:400px">
          @{
            var search = _searchTerms.GetValueOrDefault(role.Id, "");
            var filteredMembers = allMembers
              .Where(m => string.IsNullOrEmpty(search) || m.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase))
              .OrderBy(m => m.DisplayName)
              .ToList();
          }
          @foreach (var member in filteredMembers)
          {
            <LoadingAndError>
              <UserRoleItem Member="member" Role="role" />
            </LoadingAndError>
          }

          @if (!filteredMembers.Any())
          {
            <div class="list-group-item text-muted">No members found</div>
          }
        </div>

        <div class="card-footer">
          <form @onsubmit="() => DeleteRoleAsync(role.Id)" @onsubmit:preventDefault>
            <button type="submit" class="btn btn-outline-danger btn-sm w-100">Delete Role</button>
          </form>
        </div>
      </div>
    </div>
  }
</div>

@code {
  private List<GuildRole> allRoles = [];
  private List<GuildMember> allMembers = [];
  private Dictionary<string, string> _searchTerms = new();
  private string? _guildName;
  private DiscordUser? _botUser;

  private bool IsAssignableRole(GuildRole role) =>
    role.Name != "@everyone" && role.Name != _guildName && role.Name != _botUser?.Username && role.Name != _botUser?.GlobalName;

  private bool _creatingRole = false;
  private bool _creating = false;
  private string _roleName = "";

  [CascadingParameter]
  protected LoadingBoundaryContext? Loading { get; set; }

  protected override async Task OnInitializedAsync()
  {
    DiscordService.DbDataChanged += Hydrate;
    await Hydrate();
  }

  public void Dispose()
  {
    DiscordService.DbDataChanged -= Hydrate;
  }

  private async Task Hydrate()
  {
    using var _ = Loading?.Start();
    _guildName = (await Discord.GetGuildAsync())?.Name;
    _botUser = await Discord.GetBotUserAsync();
    allRoles = await Discord.GetRolesAsync();
    allMembers = await Discord.GetMembersAsync();
    await InvokeAsync(StateHasChanged);
  }

  private void HandleSearch(string roleId, string? value)
  {
    _searchTerms[roleId] = value ?? "";
    StateHasChanged();
  }

  private async Task CreateRoleAsync()
  {
    if (string.IsNullOrWhiteSpace(_roleName))
      return;

    using var _ = Loading?.Start();
    _creating = true;
    await Discord.CreateRoleAsync(_roleName, 0, true);
    _creatingRole = false;
    _roleName = "";
    _creating = false;
  }

  private async Task DeleteRoleAsync(string roleId)
  {
    using var _ = Loading?.Start();
    await Discord.DeleteRoleAsync(roleId);
    await Discord.SyncMembersAsync();
  }
}
