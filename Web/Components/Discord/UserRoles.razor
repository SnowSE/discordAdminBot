@using Web.Models
@using Web.Services
@using Web.Components.Shared
@inject DiscordService Discord

@if (_creatingRole)
{
  <div class="card mb-4" style="max-width:400px">
    <div class="card-header d-flex justify-content-between align-items-center">
      <strong>New Role</strong>
      <button type="button" class="btn-close btn-sm" aria-label="Close" @onclick="() => _creatingRole = false"></button>
    </div>
    <form @onsubmit="CreateRoleAsync" @onsubmit:preventDefault>
      <div class="card-body">
        <div class="mb-3">
          <label class="form-label">Name</label>
          <input @bind="_roleName" class="form-control" placeholder="Role name" />
        </div>
        <button type="submit" class="btn btn-primary btn-sm" disabled="@_creating">
          @if (_creating)
          {
            <span class="spinner-border spinner-border-sm me-1"></span>
          }
          Create
        </button>
      </div>
    </form>
  </div>
}
else
{
  <button type="button" class="btn btn-outline-primary btn-sm mb-3" @onclick="() => _creatingRole = true">
    + New Role
  </button>
}

<div class="row g-4">
  @foreach (var assignment in roleAssignments)
  {
    <div class="col-md-6 col-lg-4">
      <div class="card h-100">
        <div class="card-header d-flex align-items-center gap-2">
          @if (assignment.Role.Color != 0)
          {
            <span
            style="width:14px;height:14px;background:#@(assignment.Role.Color.ToString("x6"));border-radius:50%;display:inline-block;flex-shrink:0"></span>
          }
          <strong>@assignment.Role.Name</strong>
          <span class="badge bg-secondary ms-auto">@assignment.Members.Count</span>
          <form @onsubmit="() => DeleteRoleAsync(assignment.Role.Id)" @onsubmit:preventDefault style="display:contents">
            <button type="submit" class="btn btn-outline-danger btn-sm ms-auto">
              Delete
            </button>
          </form>
        </div>
        @if (assignment.Members.Count > 0)
        {
          <ul class="list-group list-group-flush">
            @foreach (var member in assignment.Members.OrderBy(m => m.DisplayName))
            {
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>@member.DisplayName</span>
                <form @onsubmit="() => RemoveRoleFromMemberAsync(member.User!.Id, assignment.Role.Id)"
                      @onsubmit:preventDefault style="display:contents">
                  <button type="submit" class="btn-close btn-sm" aria-label="Remove"></button>
                </form>
              </li>
            }
          </ul>
        }
        else
        {
          <div class="card-body text-muted">No members assigned</div>
        }

        @{
          var unassignedMembers = allMembers.Where(m => !assignment.Members.Any(am => am.User?.Id == m.User?.Id)).ToList();
        }
        @if (unassignedMembers.Count > 0)
        {
          var roleId = assignment.Role.Id;
          var pendingId = _pendingMemberIds.GetValueOrDefault(roleId, "");
          <div class="card-footer">
            <form @onsubmit="() => AddRoleToMemberAsync(pendingId, roleId)" @onsubmit:preventDefault>
              <div class="input-group">
                <select class="form-select form-select-sm" value="@pendingId"
                        @onchange="(ChangeEventArgs e) => _pendingMemberIds[roleId] = (string?)(e.Value ?? String.Empty) ?? String.Empty">
                  <option value="">-- add member --</option>
                  @foreach (var m in unassignedMembers.OrderBy(m => m.DisplayName))
                  {
                    <option value="@m.User!.Id">@m.DisplayName</option>
                  }
                </select>
                <button class="btn btn-sm btn-outline-primary" type="submit" disabled="@string.IsNullOrEmpty(pendingId)">
                  Add
                </button>
              </div>
            </form>
          </div>
        }
      </div>
    </div>
  }
</div>

@code {
  private List<RoleAssignment> roleAssignments = [];

  private bool _creatingRole = false;
  private bool _creating = false;
  private string _roleName = "";

  [CascadingParameter]
  protected LoadingBoundaryContext? Loading { get; set; }

  protected override async Task OnInitializedAsync()
  {
    DiscordService.DbDataChanged += Hydrate;
    await Hydrate();
  }

  public void Dispose()
  {
    DiscordService.DbDataChanged -= Hydrate;
  }

  protected async Task Hydrate()
  {
    using var _ = Loading?.Start();
    roleAssignments = await Discord.GetRoleAssignmentsAsync();
    allMembers = await Discord.GetMembersAsync();
    await InvokeAsync(StateHasChanged);
  }

  private List<GuildMember> allMembers = [];
  private Dictionary<string, string> _pendingMemberIds = new();

  private async Task CreateRoleAsync()
  {
    if (string.IsNullOrWhiteSpace(_roleName))
      return;

    using var _ = Loading?.Start();
    _creating = true;
    await Discord.CreateRoleAsync(_roleName, 0, true);
    _creatingRole = false;
    _roleName = "";
    _creating = false;
  }

  private async Task AddRoleToMemberAsync(string memberId, string roleId)
  {
    using var _ = Loading?.Start();
    _pendingMemberIds[roleId] = "";
    await Discord.AddRoleToMemberAsync(memberId, roleId);
    await Discord.SyncMembersAsync();
  }

  private async Task RemoveRoleFromMemberAsync(string memberId, string roleId)
  {
    using var _ = Loading?.Start();
    await Discord.RemoveRoleFromMemberAsync(memberId, roleId);
    await Discord.SyncMembersAsync();
  }

  private async Task DeleteRoleAsync(string roleId)
  {
    using var _ = Loading?.Start();
    await Discord.DeleteRoleAsync(roleId);
    await Discord.SyncMembersAsync();
  }
}
