@using Web.Models
@using Web.Models.Snow
@using Web.Services
@using Web.Components.Snow
@inject DiscordService Discord

@if (_loading)
{
  <div class="d-flex justify-content-center py-3">
    <div class="spinner-border text-primary" role="status"></div>
  </div>
}
else
{
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Assign Course to Channel</h5>
        <button type="button" class="btn-close" @onclick="CancelAsync"></button>
      </div>
      <div class="modal-body">

        @if (_error is not null)
        {
          <div class="alert alert-danger py-2 mb-3">@_error</div>
        }

        <SearchForCourse ShowRefreshButton="true" OnCourseSelected="OnCourseSelected"
                         SelectedDetailsTemplate="@SelectedSummaryTemplate" />

      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" @onclick="CancelAsync">Cancel</button>
        <button type="button" class="btn btn-primary" disabled="@_selectedCourse is null || _assigning"
                @onclick="AssignAsync">
          @if (_assigning)
          {
            <span class="spinner-border spinner-border-sm me-1"></span>
          }
          Assign Course
        </button>
      </div>
    </div>
  </div>
}

@code {
  private RenderFragment<SnowCourse> SelectedSummaryTemplate => course => @<div class="alert alert-success py-2 mb-3">
    Selected: <strong>@course.Name</strong> (CRN: @course.Crn)
  </div>;

  [CascadingParameter(Name = "ModalContext")]
  public required ModalContext Modal { get; set; }

  [Parameter] public required DiscordChannelId ChannelId { get; set; }
  [Parameter] public required List<GuildRole> AvailableRoles { get; set; }
  [Parameter] public required Action OnAssigned { get; set; }

  private bool _loading = true;
  private bool _assigning;
  private string? _error;
  private SnowCourse? _selectedCourse;

  protected override async Task OnInitializedAsync()
  {
    await InvokeAsync(StateHasChanged);
    _loading = false;
  }

  private void OnCourseSelected(SnowCourse course)
  {
    _selectedCourse = course;
    StateHasChanged();
  }

  private async Task AssignAsync()
  {
    if (_selectedCourse is null)
      return;

    try
    {
      _assigning = true;
      _error = null;

      var role = AvailableRoles.FirstOrDefault();
      if (role is null)
        throw new InvalidOperationException(
          $"No roles available in the guild when attempting to assign course '{_selectedCourse.Name}' to channel '{ChannelId.Value}'."
        );

      await Discord.AssignCourseToChannelAsync(
        _selectedCourse.Crn,
        _selectedCourse.Term.Code,
        ChannelId,
        role.Id
      );

      OnAssigned();
      Modal.Close();
    }
    catch (Exception ex) when (ex is not OperationCanceledException)
    {
      _error = $"Failed to assign course: {ex.Message}";
    }
    finally
    {
      _assigning = false;
      StateHasChanged();
    }
  }

  private void CancelAsync()
  {
    Modal.Close();
  }
}
