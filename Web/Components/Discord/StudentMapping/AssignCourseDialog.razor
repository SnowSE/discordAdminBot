@using Web.Models
@using Web.Models.Snow
@using Web.Services
@using Web.Components.Snow
@inject DiscordService Discord

@if (_loading)
{
  <div class="d-flex justify-content-center py-3">
    <div class="spinner-border text-primary" role="status"></div>
  </div>
}
else
{
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content h-100 d-flex flex-column" style="max-height: calc(90vh - 3rem)">
      <div class="modal-header d-flex justify-content-between" style="flex-shrink: 0">
        <h5 class="modal-title">Assign Course to @ChannelName</h5>
        <button type="button" class="btn-close" @onclick="CancelAsync"></button>
      </div>
      <div class="modal-body" style="overflow-y: auto; min-height: 0;">

        @if (_error is not null)
        {
          <div class="alert alert-danger py-2 mb-3">@_error</div>
        }

        <SearchForCourse OnCourseSelected="OnCourseSelected" InitialTermCode="_inferredTermCode"
                         InitialSearchQuery="@_fuzzySearchQuery" />

        @if (_selectedCourse is not null)
        {
          <div class="alert alert-success py-2 mb-3">
            Selected: <strong>@_selectedCourse.Name</strong> (CRN: @_selectedCourse.Crn)
          </div>
        }

      </div>
      <div class="modal-footer gap-2" style="flex-shrink: 0">
        <button type="button" class="btn btn-secondary" @onclick="CancelAsync">Cancel</button>
        <button type="button" class="btn btn-primary" disabled="@(_selectedCourse is null || _assigning)"
                @onclick="AssignAsync">
          @if (_assigning)
          {
            <span class="spinner-border spinner-border-sm me-1"></span>
          }
          Assign Course
        </button>
      </div>
    </div>
  </div>
}

@code {
  [CascadingParameter(Name = "ModalContext")]
  public required ModalContext Modal { get; set; }

  [Parameter] public required DiscordChannelId ChannelId { get; set; }
  [Parameter] public required string ChannelName { get; set; }
  [Parameter] public required List<GuildRole> AvailableRoles { get; set; }
  [Parameter] public required Action OnAssigned { get; set; }

  private bool _loading = true;
  private bool _assigning;
  private string? _error;
  private SnowCourse? _selectedCourse;
  private SnowTermCode? _inferredTermCode;
  private string? _fuzzySearchQuery;

  protected override async Task OnInitializedAsync()
  {
    _inferredTermCode = TryInferTermCodeFromChannelName(ChannelName);
    _fuzzySearchQuery = FuzzyMatcher.StripTermSuffix(ChannelName);
    await InvokeAsync(StateHasChanged);
    _loading = false;
  }

  private static SnowTermCode? TryInferTermCodeFromChannelName(string channelName)
  {
    // Matches patterns like "cs-101-2026-spring" → "202610"
    var parts = channelName.Split('-');
    for (int i = 0; i < parts.Length; i++)
    {
      if (int.TryParse(parts[i], out int year) && year >= 2000 && year <= 2100)
      {
        if (i + 1 < parts.Length)
        {
          var semesterCode = parts[i + 1] switch
          {
            "spring" => "10",
            "summer" => "30",
            "fall" => "40",
            _ => null,
          };

          if (semesterCode is not null)
            return new SnowTermCode($"{year}{semesterCode}");
        }
      }
    }

    return null;
  }

  private void OnCourseSelected(SnowCourse course)
  {
    _selectedCourse = course;
    StateHasChanged();
  }

  private async Task AssignAsync()
  {
    if (_selectedCourse is null)
      return;

    try
    {
      _assigning = true;
      _error = null;

      var role = AvailableRoles.FirstOrDefault();
      if (role is null)
        throw new InvalidOperationException(
          $"No roles available in the guild when attempting to assign course '{_selectedCourse.Name}' to channel '{ChannelId.Value}'."
        );

      await Discord.AssignCourseToChannelAsync(
        _selectedCourse.Crn,
        _selectedCourse.Term.Code,
        ChannelId,
        role.Id
      );

      OnAssigned();
      Modal.Close();
    }
    catch (Exception ex) when (ex is not OperationCanceledException)
    {
      _error = $"Failed to assign course: {ex.Message}";
    }
    finally
    {
      _assigning = false;
      StateHasChanged();
    }
  }

  private void CancelAsync()
  {
    Modal.Close();
  }
}
