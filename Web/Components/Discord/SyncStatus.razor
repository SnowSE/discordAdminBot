@using Web.Components.Shared
@using Web.Services
@inject DiscordService Discord

<form @onsubmit="SyncAsync" @onsubmit:preventDefault class="d-flex flex-column  gap-2">
  <button class="btn btn-outline-secondary btn-sm" type="submit" disabled="@_syncing">
    @if (_syncing)
    {
      <span class="spinner-border spinner-border-sm me-1"></span>
    }
    Sync Discord Data
  </button>
  @if (_lastSynced is not null)
  {
    <small class="text-muted">Last synced: @_lastSynced.Value.ToLocalTime().ToString("g")</small>
  }
</form>


@code {
  [CascadingParameter]
  protected LoadingBoundaryContext? Loading { get; set; }

  private bool _syncing = false;
  private DateTime? _lastSynced;

  protected override async Task OnInitializedAsync()
  {
    DiscordService.DbDataChanged += Hydrate;
    using (Loading?.Start())
    {
      await Hydrate();
    }
  }

  public void Dispose()
  {
    DiscordService.DbDataChanged -= Hydrate;
  }

  private async Task Hydrate()
  {
    _lastSynced = await Discord.GetLastSyncedAtAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task SyncAsync()
  {
    _syncing = true;
    using (Loading?.Start())
    {
      await Discord.SyncAllAsync();
    }
    _syncing = false;
  }
}
