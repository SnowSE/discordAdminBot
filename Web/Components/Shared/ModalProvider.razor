@using Microsoft.AspNetCore.Components.Web
@namespace Web.Components.Shared
@rendermode InteractiveServer

<CascadingValue Name="ModalContext" Value="Context">
  @ChildContent
  @if (Context.IsOpen)
  {
    <style>
        html,
        body {
          overflow: hidden !important;
        }
    </style>
    <div class="modal-backdrop-custom" onclick:stopPropagation="false" @onclick="OnBackdropClick" @onkeydown="OnKeyDown"
         tabindex="0">
      <div class="modal-card" @onclick:stopPropagation="true">
        @Context.Content
      </div>
    </div>
  }
</CascadingValue>

@code {
  [Parameter] public required RenderFragment ChildContent { get; set; }

  private ModalContext Context { get; set; } = new();

  protected override void OnInitialized()
  {
    Context.OnChange = () => InvokeAsync(StateHasChanged);
  }

  private void OnBackdropClick()
  {
    Context.Close();
  }

  private void OnKeyDown(KeyboardEventArgs args)
  {
    if (args.Key == "Escape")
    {
      Context.Close();
    }
  }
}
