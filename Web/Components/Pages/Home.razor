@using Web.Components.Discord
@using Web.Components.Snow
@using Web.Components.Shared
@using Web.Services
@page "/"
@rendermode InteractiveServer
@inject Web.Services.DiscordService Discord

<PageTitle>Discord Overview</PageTitle>
<LoadingAndError>
  <div class="d-flex align-items-center gap-3 mb-3">
    <h1 class="mb-0">Discord Overview</h1>
    <SyncStatus />
  </div>

  <div class="mb-4">
    @if (_addingCourse)
    {
      <div class="mt-1">
        <LoadingAndError>
          <AddMyCourse OnCancel="() => _addingCourse = false" />
        </LoadingAndError>
      </div>
    }
    else
    {
      <button class="btn btn-primary btn-sm" @onclick="() => _addingCourse = true">
        + Add My Course
      </button>
    }
  </div>

  <InviteToServer />
  <LoadingAndError>
    <ChannelList />
  </LoadingAndError>
</LoadingAndError>

@code {
  private bool _addingCourse;
}
