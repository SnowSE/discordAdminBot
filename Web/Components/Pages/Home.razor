@using Web.Components.Discord
@using Web.Components.Shared
@using Web.Components.Shared.Icons
@using Web.Components.Snow
@using Web.Models.Snow
@using Web.Services
@page "/"
@rendermode InteractiveServer
@inject Web.Services.DiscordService Discord
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<PageTitle>Discord Overview</PageTitle>
<LoadingAndError>
  <ModalProvider>
    <div class="page-header mb-4 p-2 pb-3 border-bottom">
      <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
        <h1 class="mb-0 me-auto">Discord Overview</h1>
        @if (!string.IsNullOrWhiteSpace(_cloudflareEmail))
        {
          <div class="text-muted small">
            Signed in as <span class="fw-semibold">@_cloudflareEmail</span>
          </div>
        }
      </div>

      <div class="d-flex flex-wrap gap-2">
        @if (!_addingCourse)
        {
          <button class="btn btn-primary" @onclick="() => _addingCourse = true">
            <PlusIcon CssClass="me-1" Style="margin-top: -2px" />
            Add My Course
          </button>
        }
        <SyncStatus />
        <RefreshCourseRosters CoursesToSync="@_courseChannelAssignments"
                              OnSyncCompleted="ReloadChannelsAsync" />
        <SyncCourseList />
      </div>
    </div>

  @if (_addingCourse)
  {
    <LoadingAndError>
      <AddMyCourse InitialSearchQuery="@_cloudflareEmail" OnCancel="() => _addingCourse = false" />
    </LoadingAndError>
  }

  <br>
  <InviteToServer />
  <BotRoles />
  <LoadingAndError>
    <ChannelList @ref="_channelListRef" />
  </LoadingAndError>
</ModalProvider>
</LoadingAndError>

@code {
  private bool _addingCourse;
  private ChannelList? _channelListRef;
  private List<(SnowTermCode TermCode, SnowCrn Crn)> _courseChannelAssignments = [];
  private string? _cloudflareEmail;

  private string _syncButtonText => $"Refresh {_courseChannelAssignments.Count} Roster{(_courseChannelAssignments.Count != 1 ? "s" : "")}";

  protected override async Task OnInitializedAsync()
  {
    _cloudflareEmail = HttpContextAccessor.HttpContext?.Request.Headers[
      "Cf-Access-Authenticated-User-Email"
    ].ToString();

    DiscordService.DbDataChanged += ReloadChannelsAsync;
    await ReloadChannelsAsync();
  }

  public void Dispose()
  {
    DiscordService.DbDataChanged -= ReloadChannelsAsync;
  }

  private async Task ReloadChannelsAsync()
  {
    _courseChannelAssignments = (await Discord.GetCourseChannelAssignmentsAsync())
      .Select(
        courseChannelAssignment => (courseChannelAssignment.TermCode, courseChannelAssignment.Crn)
      )
      .ToList();
    await InvokeAsync(StateHasChanged);
  }
}
