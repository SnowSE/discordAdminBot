@using Web.Components.Discord
@using Web.Components.Snow
@using Web.Components.Shared
@using Web.Services
@page "/"
@rendermode InteractiveServer
@inject Web.Services.DiscordService Discord

<PageTitle>Discord Overview</PageTitle>
<LoadingAndError>
  <div class="d-flex  flex-wrap gap-2 mb-3">
    <h1 class="mb-0 me-auto">Discord Overview</h1>

    @if (!_addingCourse)
    {
      <button class="btn btn-primary fw-bold" @onclick="() => _addingCourse = true">
        + Add My Course
      </button>
    }

    <SyncStatus />
    <button class="btn btn-outline-secondary" @onclick="() => _channelListRef?.OpenSyncAllModal()">
      Sync All Courses
    </button>
  </div>

  @if (_addingCourse)
  {
    <LoadingAndError>
      <AddMyCourse OnCancel="() => _addingCourse = false" />
    </LoadingAndError>
  }

  <InviteToServer />
  <LoadingAndError>
    <ChannelList @ref="_channelListRef" />
  </LoadingAndError>
</LoadingAndError>

@code {
  private bool _addingCourse;
  private ChannelList? _channelListRef;
}
