@using Web.Components.Discord
@using Web.Components.Shared
@using Web.Services
@page "/"
@rendermode InteractiveServer
@inject Web.Services.DiscordService Discord

<PageTitle>Discord Overview</PageTitle>
<LoadingAndError>
  <LoadingDemo />
  <div class="d-flex align-items-center gap-3 mb-3">
    <h1 class="mb-0">Discord Overview</h1>
    <SyncStatus />
  </div>

  <Overview Members="@_members" Channels="@_channels" Roles="@_roles" />
  <hr />
  <InviteToServer />
  <UserRoles @key="_roles" />
</LoadingAndError>

@code {
  private List<Web.Models.GuildMember> _members = [];
  private List<Web.Models.GuildChannel> _channels = [];
  private List<Web.Models.GuildRole> _roles = [];

  protected override async Task OnInitializedAsync()
  {
    DiscordService.DbDataChanged += Hydrate;
    await Hydrate();
  }

  public void Dispose()
  {
    DiscordService.DbDataChanged -= Hydrate;
  }

  private async Task Hydrate()
  {
    _members = await Discord.GetMembersAsync();
    _channels = await Discord.GetChannelsAsync();
    _roles = await Discord.GetRolesAsync();
  }
}
